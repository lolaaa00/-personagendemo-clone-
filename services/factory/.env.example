# ──────────────────────────────────────────────
# PersonaGen Account Factory — Environment Vars
# ──────────────────────────────────────────────

# Server
FACTORY_PORT=8080                          # Port the API listens on
FACTORY_API_KEY=                           # Bearer token for authenticating API requests (required)
ALLOWED_ORIGINS=http://localhost:3000      # Comma-separated CORS origins

# AgenticMail integration
MAIL_URL=http://mail:8080                  # Base URL of the AgenticMail service (required)
MAIL_API_KEY=                              # API key for AgenticMail (required)

# Proxy (optional — for browser sessions)
PROXY_HOST=                                # SOCKS5/HTTP proxy hostname
PROXY_PORT=                                # Proxy port
PROXY_USER=                                # Proxy auth username
PROXY_PASS=                                # Proxy auth password

# CAPTCHA solving (optional)
CAPTCHA_PROVIDER=                          # "2captcha" or "anticaptcha"
CAPTCHA_API_KEY=                           # API key for the CAPTCHA service

# Engine webhook (optional — fires on completion/failure)
ENGINE_WEBHOOK_URL=                        # Full URL to local engine webhook endpoint

# Rate / safety limits
MAX_CREATIONS_PER_DAY=3                    # Max account creations per 24h
COOLDOWN_MINUTES=30                        # Cooldown between creation attempts

# Storage paths
PROFILES_DIR=/data/profiles                # Persistent browser profile directory
DB_PATH=/data/factory.db                   # SQLite database file path

# Encryption
ENCRYPTION_KEY=                            # 32-byte hex string for AES-256-GCM cookie encryption
