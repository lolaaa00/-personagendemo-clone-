# ──────────────────────────────────────────────
# PersonaGen AgenticMail — Environment Vars
# ──────────────────────────────────────────────

# Domain
MAIL_DOMAIN=mail.personagen.com           # Primary mail domain for Stalwart
MAIL_HOSTNAME=mail.personagen.com          # MX hostname

# Admin
MAIL_ADMIN_USER=admin                      # Admin inbox username
MAIL_ADMIN_PASS=                           # Admin inbox password (required)

# API
MAIL_API_PORT=8080                         # AgenticMail API port
MAIL_API_KEY=                              # Bearer token for API authentication (required)

# Health check
HEALTH_PORT=8081                           # Health endpoint port

# DKIM
DKIM_SELECTOR=personagen                   # DKIM DNS selector

# Stalwart
STALWART_DATA_DIR=/data/stalwart           # Stalwart data directory
STALWART_ADMIN_PORT=443                    # Stalwart admin API port

# TLS (optional — for production)
TLS_CERT_PATH=                             # Path to TLS certificate (PEM)
TLS_KEY_PATH=                              # Path to TLS private key (PEM)
