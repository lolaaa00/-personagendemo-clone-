# ── Branding (optional) ───────────────────────────────
# Share-card / meta branding. Defaults to PersonaGen when unset. Set these on a
# per-client deployment (e.g. HoneyX) so social previews show that brand and URL
# instead of the product default.
PUBLIC_BRAND_NAME=
PUBLIC_BRAND_URL=
PUBLIC_BRAND_TAGLINE=
PUBLIC_BRAND_OG_IMAGE=

# ── Supabase ──────────────────────────────────────────
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── AI Providers ──────────────────────────────────────
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# ── Image / Video Generation ──────────────────────────
FAL_API_KEY=

# ── Social Distribution ───────────────────────────────
# Zernio is the primary posting/analytics/connection provider. Composio is
# kept only as an image-generation fallback, not for social distribution.
ZERNIO_API_KEY=
COMPOSIO_API_KEY=
COMPOSIO_AUTH_CONFIG_FACEBOOK=
COMPOSIO_AUTH_CONFIG_INSTAGRAM=
COMPOSIO_AUTH_CONFIG_YOUTUBE=
COMPOSIO_AUTH_CONFIG_TIKTOK=

# ── Content Pipeline ──────────────────────────────────
FIRECRAWL_API_KEY=
USER_SECRETS_ENCRYPTION_KEY=

# ── UGC Generation Tuning (optional — all have working defaults) ─────
# Model slugs (fal.ai) — override to swap providers/tiers without a code change.
# UGC_NANO_MODEL=fal-ai/nano-banana-2/edit
# UGC_TTS_MODEL=fal-ai/elevenlabs/tts/turbo-v2.5
# UGC_TALKINGHEAD_MODEL=veed/fabric-1.0
# UGC_BROLL_MODEL=fal-ai/kling-video/o3/standard/image-to-video
# UGC_BROLL_MODEL_CINEMATIC=fal-ai/kling-video/o3/pro/reference-to-video
# UGC_BROLL_MODEL_PREMIUM=fal-ai/veo3.1/image-to-video
# UGC_FABRIC_RES=720p
# UGC_VIDEO_DURATION=5
# UGC_CINEMATIC_DURATION=15
# UGC_DEFAULT_VOICE=Adam
# UGC_FONT_FILE=

# ── Internal Services ─────────────────────────────────
FACTORY_API_KEY=
FACTORY_ENCRYPTION_KEY=
MAIL_API_KEY=
HERMES_API_KEY=
MCP_BRIDGE_TOKEN=
TAVILY_API_KEY=

# ── Autopilot Tuning (optional) ───────────────────────
# AUTOPILOT_MAX_PER_RUN=1
# AUTOPILOT_LOOKAHEAD_DAYS=2
# ANALYTICS_SYNC_INTERVAL_MS=14400000
# RUN_SCHEDULER=true

# ── Billing — NOT YET ACTIVE ──────────────────────────
# Stripe integration is coming soon. Leave these unset until payments go live.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_STARTER_PRICE_ID=
# STRIPE_PRO_PRICE_ID=
# STRIPE_ENTERPRISE_PRICE_ID=
