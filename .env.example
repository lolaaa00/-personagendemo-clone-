# ── Branding (optional) ───────────────────────────────
# Share-card / meta branding. Defaults to PersonaGen when unset. Set these on a
# per-client deployment (e.g. HoneyX) so social previews show that brand and URL
# instead of the product default.
PUBLIC_BRAND_NAME=
PUBLIC_BRAND_URL=
# PUBLIC_APP_URL=               # absolute origin for Stripe return URLs when behind a proxy (default: request origin)
PUBLIC_BRAND_TAGLINE=
PUBLIC_BRAND_OG_IMAGE=

# ── Supabase ──────────────────────────────────────────
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── AI Providers ──────────────────────────────────────
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# ── Image / Video Generation ──────────────────────────
FAL_API_KEY=

# ── Social Distribution ───────────────────────────────
# Zernio is the only social distribution provider (posting, analytics,
# connections). Composio was removed from the app entirely — no COMPOSIO_*
# variable is read anywhere in personagen-svelte any more.
ZERNIO_API_KEY=

# ── Content Pipeline ──────────────────────────────────
FIRECRAWL_API_KEY=
USER_SECRETS_ENCRYPTION_KEY=

# ── Registration ──────────────────────────────────────
# When set, /signup requires this PIN (invite-only deployments). NOTE: the gate
# is only enforceable if public signups are DISABLED on the Supabase project
# (GOTRUE_DISABLE_SIGNUP=true self-hosted / "Allow new users to sign up" off
# hosted) — the app creates users server-side with the service role, so it
# keeps working with signups disabled. Leave empty for open registration.
ADMIN_PIN=

# ── UGC Generation Tuning (optional — all have working defaults) ─────
# Model slugs (fal.ai) — override to swap providers/tiers without a code change.
# UGC_NANO_MODEL=fal-ai/nano-banana-2/edit
# UGC_TTS_MODEL=fal-ai/elevenlabs/tts/turbo-v2.5
# UGC_TALKINGHEAD_MODEL=veed/fabric-1.0
# UGC_BROLL_MODEL=fal-ai/kling-video/o3/standard/image-to-video
# UGC_BROLL_MODEL_CINEMATIC=fal-ai/kling-video/o3/pro/reference-to-video
# UGC_BROLL_MODEL_PREMIUM=fal-ai/veo3.1/image-to-video
# UGC_FABRIC_RES=720p
# UGC_VIDEO_DURATION=5
# UGC_CINEMATIC_DURATION=15
# UGC_DEFAULT_VOICE=Adam
# UGC_FONT_FILE=
# UGC_CARD_RENDERER=            # set to model|off|false to disable the $0 local ffmpeg text-card renderer
# UGC_QUALITY_FLOOR=5           # 0-10 QA score below which a generation is rejected
# UGC_IMAGE_EDIT_MODEL_OR=google/gemini-3.1-flash-image   # OpenRouter image slug
# UGC_BROLL_MODEL_OR=kwaivgi/kling-v3.0-std              # OpenRouter video slug
# UGC_BROLL_AUDIO=true          # set false to mute generated b-roll audio
# UGC_EXTRA_VOICES=             # comma-separated extra TTS voice names
# UGC_VIDEO_COMPRESS=true       # set false to skip the web re-encode
# UGC_VIDEO_CRF=27              # 18-35; out-of-range falls back to 27
# FFMPEG_PATH=ffmpeg            # override when ffmpeg is not on PATH
# GEMINI_MODEL=gemini-3.5-flash
# OPENROUTER_GEMINI_MODEL=google/gemini-3.5-flash

# ── Internal Services ─────────────────────────────────
FACTORY_API_KEY=
FACTORY_ENCRYPTION_KEY=
MAIL_API_KEY=
HERMES_API_KEY=
MCP_BRIDGE_TOKEN=
TAVILY_API_KEY=

# ── Spend caps — the last line of defence against a runaway loop ──────
# Checked before every paid generation against the generation_events ledger.
# A cap of 0 DISABLES that check entirely. Both fail OPEN on a ledger read
# error, so a database blip cannot halt generation. Per-seat workspace caps
# are set in the app (Settings → Team) and are independent of these.
# MAX_DAILY_SPEND_PER_AGENT_USD=15    # per persona, since midnight UTC
# MAX_MONTHLY_SPEND_PER_USER_USD=300  # per user, since the 1st of the month UTC

# ── Autopilot Tuning (optional) ───────────────────────
# AUTOPILOT_MAX_PER_RUN=24            # generations per run (per-run spend cap, not the runway)
# AUTOPILOT_LOOKAHEAD_DAYS=7          # how far ahead slots are filled
# AUTOPILOT_MAX_SLOT_ATTEMPTS=3       # failures before a slot is marked failed and skipped
# ANALYTICS_SYNC_INTERVAL_MS=14400000
# RUN_SCHEDULER=true
# AUTOPILOT_RUN_INTERVAL_MS=
# PUBLISH_ENFORCE_ACTIVE_HOURS=true   # set false to publish outside 8am-8pm agent-local

# ── Credits, platform admin & activity log ────────────
# These switches also exist as database settings, refreshed every 15s. An env
# value set here OVERRIDES the database one; leave blank to steer from the
# admin UI instead. See src/lib/server/flags.ts.
#
# CREDITS_ENFORCE=              # off (default) | shadow (debit recorded, never blocks) | enforce
# CREDIT_MARKUP=                # retail multiplier on estimated provider cost (1 = at cost); emergency override of Admin Console → Margin
# ACTIVITY_LOG=                 # off (default) | on — pseudonymous request/domain event log
# ACTIVITY_PEPPER=              # hashing secret for the activity log; generated in the DB
#                               # on first migration — set here only to pin it explicitly
# ACTIVITY_RETENTION_DAYS=180   # activity rows older than this are purged
# PLATFORM_ADMIN_EMAILS=        # comma-separated bootstrap admins, IN ADDITION to platform_admins rows

# ── Programmatic API keys ─────────────────────────────
# Required only for machine auth (the agentic controller). Mints a short-lived
# user JWT so PostgREST applies the same RLS as a real login. Without it,
# API-key auth throws instead of silently falling through unauthenticated.
# Supabase dashboard → Project Settings → API → JWT Secret.
SUPABASE_JWT_SECRET=

# ── Billing — NOT YET ACTIVE ──────────────────────────
# Stripe integration is coming soon. Leave these unset until payments go live.
# STRIPE_SECRET_KEY=            # sk_live_… — setting this OPENS payments (/billing packs, /api/billing/checkout)
# STRIPE_WEBHOOK_SECRET=        # whsec_… from the Stripe endpoint for https://<host>/api/billing/webhook (required to credit wallets)
# STRIPE_STARTER_PRICE_ID=
# STRIPE_PRO_PRICE_ID=
# STRIPE_ENTERPRISE_PRICE_ID=
