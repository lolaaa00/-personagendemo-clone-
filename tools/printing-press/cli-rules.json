{
  "safety_policies": {
    "block_destructive_commands": true,
    "forbidden_flags": ["--delete", "--purge", "--force-delete", "--wipe-all"],
    "require_user_confirmation": [
      "pp-stripe refund",
      "pp-clickup delete-task",
      "pp-clickup update-status --closed"
    ]
  },
  "token_limits": {
    "default_item_limit": 10,
    "max_item_limit": 50,
    "enforce_markdown_tables": true
  },
  "error_recovery": {
    "auto_retry_on_network_timeout": true,
    "retry_attempts": 3,
    "retry_delay_seconds": 2
  }
}
