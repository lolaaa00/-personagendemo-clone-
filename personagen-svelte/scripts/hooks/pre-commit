#!/bin/sh
# Keeps src/lib/changelog.ts in step with git history on every commit, and
# refuses a commit that stages a lint ERROR.
#
# Why here and not in the build: the Docker build context is personagen-svelte/,
# .git lives one level up at the repo root, and node:22-alpine ships no git
# binary — so `npm run changelog` during `docker build` finds no history, hits
# its graceful fallback, and silently changes nothing. Generating at commit time
# means the repository the deploy pulls from is always already current, with no
# runtime work and no deploy lag.
set -e

REPO_ROOT=$(git rev-parse --show-toplevel)
APP="$REPO_ROOT/personagen-svelte"
CHANGELOG="$APP/src/lib/changelog.ts"

# ── Guard: non-portable staged filenames ───────────────────────────────────
# A file literally named with a Windows temp path (carrying U+F03A, the
# private-use colon Windows substitutes for ':') was committed to the repo root
# on 2026-09-05 by a broad `git add`. Git on Windows then refuses to `git rm` it
# by name, because it re-reads the name as a drive letter. Reject the whole
# class at the gate rather than relying on anyone noticing it in a diff.
# --diff-filter=d excludes deletions: REMOVING a badly-named file must always be
# allowed, or the guard would trap the very file it is meant to keep out.
# core.quotepath=false prints the real bytes instead of \357\200\272 escapes, so
# the non-ASCII rule reports the actual cause.
bad=$(git -c core.quotepath=false diff --cached --name-only --diff-filter=d | awk '
  /[^\x20-\x7e]/   { print "  non-ASCII character: " $0; next }
  /:/              { print "  colon in path:       " $0; next }
  /\\/             { print "  backslash in path:   " $0; next }
  length($0) > 200 { print "  path over 200 chars: " $0; next }
')
if [ -n "$bad" ]; then
  echo "[pre-commit] REFUSED - non-portable filename(s) staged:" >&2
  echo "$bad" >&2
  echo "[pre-commit] These break checkout on other platforms and resist 'git rm'." >&2
  echo "[pre-commit] Unstage with: git restore --staged <path>   (or rename the file)" >&2
  exit 1
fi

# ── Guard: lint ERRORS in staged sources ───────────────────────────────────
# Errors only (--quiet); the warning ratchet stays a CI concern, because the
# count is repo-wide and a per-file run cannot judge it. On 2026-09-17 lint:ci
# sat red for two commits with nobody noticing, because nothing ran it at commit
# time; the same day a `\b` that had become a literal 0x08 byte inside a regex
# reached a working copy — the rule that catches that (no-control-regex) is an
# error, and this is the first place it can refuse before the commit exists.
#
# eslint's exit codes are load-bearing: 1 = it found errors (refuse), 2 = it
# could not run (warn and proceed — a broken linter must not block every commit
# in a tree three sessions share). Never collapse the two.
staged_src=$(git diff --cached --name-only --diff-filter=d -- \
  'personagen-svelte/*.ts' 'personagen-svelte/*.js' 'personagen-svelte/*.mjs' 'personagen-svelte/*.svelte' \
  | grep -v '^personagen-svelte/src/lib/changelog.ts$' || true)
if [ -n "$staged_src" ] && [ -x "$APP/node_modules/.bin/eslint" ]; then
  # Absolute paths, so the run is independent of the hook's own cwd.
  list=$(printf '%s\n' "$staged_src" | sed "s|^|$REPO_ROOT/|")
  rc=0
  # shellcheck disable=SC2086 -- deliberate word splitting; no path here carries spaces (see filename guard above)
  (cd "$APP" && ./node_modules/.bin/eslint --quiet --no-warn-ignored $list) || rc=$?
  if [ "$rc" -eq 1 ]; then
    echo "[pre-commit] REFUSED - lint error(s) in staged source (see above)." >&2
    echo "[pre-commit] Fix them, or if a rule is wrong for this line, disable it there with a reason." >&2
    exit 1
  elif [ "$rc" -ne 0 ]; then
    echo "[pre-commit] eslint could not run (exit $rc) — committing WITHOUT the lint guard." >&2
  fi
fi

# ── changelog.ts is generated: what was pre-staged is irrelevant ───────────
# Drop any copy already in the index BEFORE anything that can exit early.
# Measured on 2026-09-17: with a stale copy staged, regeneration heals it on
# the normal path — but on every path that skipped regeneration (generator
# missing, generator throwing) the hook exited 0 and committed whatever was
# staged, which shipped a changelog missing real entries. After these two lines
# the index and the worktree both hold HEAD's copy, so any early exit commits an
# UNCHANGED file: trailing by one more, never rolled back.
git restore --staged -- "$CHANGELOG" 2>/dev/null || true
git checkout -- "$CHANGELOG" 2>/dev/null || true

[ -f "$APP/scripts/generate-changelog.mjs" ] || exit 0

# Regenerate against the history as it stands. The commit being written is not
# in the log yet, so the entry for it lands on the NEXT commit — the changelog
# trails by exactly one, which is the same behaviour as any build-time
# generator and is corrected on the following commit.
node "$APP/scripts/generate-changelog.mjs" >/dev/null 2>&1 || {
  echo "[pre-commit] changelog generation failed — committing without regenerating (HEAD's copy, not a stale one)." >&2
  git checkout -- "$CHANGELOG" 2>/dev/null || true
  exit 0
}

if ! git diff --quiet -- "$CHANGELOG"; then
  git add "$CHANGELOG"
  echo "[pre-commit] changelog.ts regenerated and staged."
fi
