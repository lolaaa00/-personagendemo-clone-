{
  "name": "personagen-svelte",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "npm run changelog && vite build",
    "preview": "vite preview",
    "prepare": "git -C .. config core.hooksPath personagen-svelte/scripts/hooks || true; svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "lint:ci": "eslint . --max-warnings=1129",
    "format": "prettier --write .",
    "test:unit": "vitest run --project=unit",
    "test:integration": "vitest run --project=integration",
    "test:watch": "vitest --project=unit",
    "test": "npm run test:unit && npm run test:e2e",
    "test:e2e": "playwright install && playwright test",
    "verify:money": "node scripts/apply-migration.mjs --status --strict && node scripts/verify-recorded-migrations.mjs --strict && node scripts/verify-credits-db.mjs && node scripts/verify-roles-db.mjs && node scripts/verify-activity-db.mjs",
    "smoke:live": "node scripts/e2e-smoke.mjs",
    "preflight": "node scripts/preflight.mjs",
    "backup": "node scripts/backup-db.mjs",
    "backup:verify": "node scripts/backup-db.mjs --verify",
    "backup:check-restore": "node scripts/backup-db.mjs --check-restore",
    "backup:sql": "node scripts/backup-db.mjs --sql",
    "backfill:faststart": "node --env-file=.env --experimental-strip-types scripts/backfill-faststart.ts",
    "backfill:compress": "node --env-file=.env --experimental-strip-types scripts/backfill-compress.ts",
    "backfill:persona-v2": "node scripts/backfill-persona-v2.mjs",
    "switch:media-host": "node --env-file=.env --experimental-strip-types scripts/switch-media-host.ts",
    "changelog": "node scripts/generate-changelog.mjs",
    "changelog:check": "node scripts/generate-changelog.mjs --check",
    "changelog:list": "node scripts/generate-changelog.mjs --list"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@sveltejs/adapter-node": "^5.5.4",
    "@sveltejs/kit": "^2.57.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@types/node": "^22",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.17.0",
    "globals": "^17.4.0",
    "prettier": "^3.8.1",
    "prettier-plugin-svelte": "^3.5.1",
    "svelte": "^5.55.2",
    "svelte-check": "^4.4.6",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.1",
    "vite": "^8.0.7",
    "vitest": "^4.1.3"
  },
  "dependencies": {
    "@google/genai": "^2.8.0",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.107.0",
    "undici": "^7.28.0"
  }
}
