# PersonaGen — gitignore

# Environment & secrets
.env
env_vars.txt
db_dump.txt

# Dependencies
node_modules/

# Build output
.wrangler/
dist/

# Backups (use git history instead)
backup/

# Test artifacts & automation secrets
temp_test/
*.log
*.tmp

# Session & credential files (NEVER commit)
cookies.json
**/cookies.json
vault.enc
**/vault.enc
**/device_*.json
**/mobile_session.json
**/chrome-profile/

# IDE / OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Screenshots & media artifacts
screenshots/
**/screenshots/

# Account Factory
services/factory/data/
services/factory/node_modules/
services/mail/data/
services/mail/node_modules/
*.db
*.db-journal
services/factory/src/data/
services/mail/src/data/


# graphify query-time stamp — rewritten on every /graphify query, pure churn
graphify-out/cache/last_query_stamp

# Scratch/temp artifacts that a broad `git add` would otherwise sweep into the
# repo root. A file literally named with a Windows temp path was committed once
# (2026-09-05); the pre-commit filename rule is the real guard, this is belt.
*scratchpad*
*AppData*Temp*

# graphify query cache — rebuilt locally on every /graphify run; never ship it
graphify-out/cache/
