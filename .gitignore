# PersonaGen — gitignore

# Environment & secrets
.env
env_vars.txt
db_dump.txt

# Dependencies
node_modules/

# Build output
.wrangler/
dist/

# Backups (use git history instead)
backup/

# Test artifacts & automation secrets
temp_test/
*.log
*.tmp

# Session & credential files (NEVER commit)
cookies.json
**/cookies.json
vault.enc
**/vault.enc
**/device_*.json
**/mobile_session.json
**/chrome-profile/

# IDE / OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Screenshots & media artifacts
screenshots/
**/screenshots/

